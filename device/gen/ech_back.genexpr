// ECHOLIVITY gen~ BACK
// Port of reference/engine.py: spring_process(), engine routing,
// feedback_process(), output_stage().
// in1 dry L, in2 dry R, in3 engine input e (from FRONT),
// in4 convolution L, in5 convolution R
// out1 L, out2 R, out3 dub feedback send (-> tapin~), out4 spring->IR send (-> tapin~)

Param decay(2.0, min=0.3, max=8);
Param damping(0.8, min=0, max=1);
Param boing(0.4, min=0, max=1);
Param tension(0.44, min=0, max=1);
Param dispersion(0.55, min=0, max=1);
Param resonance(0.35, min=0, max=1);
Param movement(0.3, min=0, max=1);
Param modulation(0.15, min=0, max=1);
Param engine_mode(2, min=0, max=4);
Param ir_level(0, min=-24, max=6);
Param model_level(0, min=-24, max=6);
Param blend(0.5, min=0, max=1);
Param feedback(0, min=0, max=1);
Param fb_tone(0, min=-1, max=1);
Param fb_drive(0.2, min=0, max=1);
Param fb_damping(0.3, min=0, max=1);
Param self_osc(0, min=0, max=1);
Param tone(0, min=-1, max=1);
Param width(1, min=0, max=2);
Param drive(0.25, min=0, max=1);
Param drywet(0.35, min=0, max=1);   // Live parameter 'Mix' (gen~ reserves the name mix)
Param output(0, min=-24, max=6);
Param ir_peak(1, min=0.001, max=100000);   // set by ir_loader.js
Param have_ir(0, min=0, max=1);            // set by ir_loader.js

Delay sp0(12000);
Delay sp1(12000);
Data ap(256, 2);          // 64 stages x Kmax 4, per spring
Data st(64);              // misc state, see indices below

// state indices
// 0,1 delay smooth  2 g smooth  3 hp  4 lp  5 envf  6 envs  7 swx  8 swv  9 slap
// 10,11 wob  12,13 wob2  14 lfo  15,16 damp  17-20 peak tdf2  21,22 splash
// 23-26 out dc  27 api  28-38 feedback  39-43,50 output  44 init  45-49 gain smooth  51-56,58,59 tank/recovery  57 osc agc

asym(x, k, b) {
	tb = tanh(k * b);
	s2 = 1 - tb * tb;
	return (tanh(k * (x + b)) - tb) / (k * s2);
}

opc(fc) {
	return 1 - exp(-twopi * fc / samplerate);
}


modelpeak(dec, ten, disp) {
	kk = max(1, floor(samplerate / 22050 + 0.5));
	aa = -(0.45 + 0.35 * disp);
	lp = 0.08 - 0.05 * ten;
	apd = 64 * kk * (1 - aa) / (1 + aa);
	tdl = kk * (1 - aa * aa) / (1 + 2 * aa * cos(kk * twopi * 400 / samplerate) + aa * aa);
	le = (max(lp * samplerate - apd, 8) + 64 * tdl) / samplerate;
	gg = pow(10, -3 * le / (1.15 * dec));
	return 0.3 * sqrt(1 - gg * gg) * 5.5 / (1 - gg);
}

mode = floor(engine_mode + 0.5);
serial = mode >= 3 ? 1 : 0;

// ---------------- parameter smoothing (20 ms) ----------------
sm = 1 - exp(-1 / (0.02 * samplerate));
irg_t = pow(10, ir_level / 20);
mdg_t = pow(10, model_level / 20);
irg = st.peek(45) + sm * (irg_t - st.peek(45));     st.poke(irg, 45);
mdg = st.peek(46) + sm * (mdg_t - st.peek(46));     st.poke(mdg, 46);
bl = st.peek(47) + sm * (blend - st.peek(47));      st.poke(bl, 47);
mx = st.peek(48) + sm * (drywet - st.peek(48));        st.poke(mx, 48);
go_t = pow(10, output / 20);
go = st.peek(49) + sm * (go_t - st.peek(49));       st.poke(go, 49);

// ---------------- spring model ----------------
K = max(1, floor(samplerate / 22050 + 0.5));
dec = decay * (serial ? 0.3 : 1);
a0 = -(0.45 + 0.35 * dispersion);
// spring geometry: Fisher K-10 manual, one-way 29 / 37 ms (tension 0.44)
loop_s = 0.08 - 0.05 * tension;
ratio = 37 / 29;
ap_dc = 64 * K * (1 - a0) / (1 + a0);
// effective loop time at 400 Hz (the cascade delays lows far more than mids)
cw = cos(K * twopi * 400 / samplerate);
tdl_lo = K * (1 - a0 * a0) / (1 + 2 * a0 * cw + a0 * a0);
loop_eff = (max(loop_s * samplerate - ap_dc, 8) + 64 * tdl_lo) / samplerate;
g_t = pow(10, -3 * loop_eff / (1.15 * dec));
fr = 900 + 2100 * tension;
gdb = 60 * loop_eff * 2 * resonance / dec;
A = pow(10, gdb / 40);
w0 = twopi * fr / samplerate;
alpha = sin(w0) / 3;
a0n = 1 + alpha / A;
b0 = (1 + alpha * A) / a0n;
b1 = (-2 * cos(w0)) / a0n;
b2 = (1 - alpha * A) / a0n;
a1 = (-2 * cos(w0)) / a0n;
a2 = (1 - alpha / A) / a0n;
pnorm = 1 / (A * A);
c_damp = opc(1500 + 9500 * pow(1 - damping, 2));
out_scale = sqrt(max(1 - g_t * g_t, 0.0001)) * 5.5;
r_dc = 1 - twopi * 10 / samplerate;

// spring input: IR>Model feeds the convolution output to the springs
s_in = mode == 3 ? 0.5 * (in4 + in5) * irg : in3;

// tank feed high-passes, Fisher K-10 values (C1/R3 ~300 Hz, C3/R7 59 Hz)
hpst = st.peek(3) + opc(300) * (s_in - st.peek(3));
st.poke(fixdenorm(hpst), 3);
lpst = st.peek(4) + opc(59) * ((s_in - hpst) - st.peek(4));
st.poke(fixdenorm(lpst), 4);
xin = (s_in - hpst) - lpst;

// transient detector -> slap / sway
ax = abs(s_in);
envf = st.peek(5) + opc(1 / (twopi * 0.001)) * (ax - st.peek(5));
envs = st.peek(6) + opc(1 / (twopi * 0.06)) * (ax - st.peek(6));
st.poke(fixdenorm(envf), 5);
st.poke(fixdenorm(envs), 6);
tr = max(envf - 1.5 * envs, 0);
hit = min(tr * 8, 1);
if ((noise() + 1) * 0.5 < movement * 0.4 / samplerate) {
	hit = max(hit, 0.3 + 0.2 * (noise() + 1));
}
slap = max(st.peek(9) * exp(-1 / (0.12 * samplerate)), hit);
st.poke(fixdenorm(slap), 9);
w_sw = twopi * 6 / samplerate;
r_sw = exp(-1 / (0.4 * samplerate));
sx = st.peek(7);
sv = st.peek(8);
nx = r_sw * (cos(w_sw) * sx - sin(w_sw) * sv) + hit * 0.02;
nv = r_sw * (sin(w_sw) * sx + cos(w_sw) * sv);
st.poke(fixdenorm(nx), 7);
st.poke(fixdenorm(nv), 8);
sway = clamp(nx * 10, -1, 1);

lfo = st.peek(14) + twopi * (0.2 + 0.9 * modulation) / samplerate;
lfo = lfo > twopi ? lfo - twopi : lfo;
st.poke(lfo, 14);

g = st.peek(2) + sm * (g_t - st.peek(2));
st.poke(g, 2);

nz = noise();
sp_h = st.peek(21) + opc(2500) * (nz - st.peek(21));
st.poke(fixdenorm(sp_h), 21);
sp_l = st.peek(22) + opc(6000) * ((nz - sp_h) - st.peek(22));
st.poke(fixdenorm(sp_l), 22);
splash = sp_l * boing * slap * envs * 1.5;

c_wob = opc(0.7);
w0a = st.peek(10) + c_wob * (noise() - st.peek(10));
w1a = st.peek(11) + c_wob * (noise() - st.peek(11));
st.poke(fixdenorm(w0a), 10);
st.poke(fixdenorm(w1a), 11);
w0b = st.peek(12) + c_wob * (w0a - st.peek(12));
w1b = st.peek(13) + c_wob * (w1a - st.peek(13));
st.poke(fixdenorm(w0b), 12);
st.poke(fixdenorm(w1b), 13);

mod0 = 1 + 0.006 * movement * w0b * 40 + 0.004 * modulation * sin(lfo) + 0.03 * boing * sway;
mod1 = 1 + 0.006 * movement * w1b * 40 + 0.004 * modulation * sin(lfo + 0.5 * pi) - 0.024 * boing * sway;
dt0 = clamp(loop_s * samplerate * mod0 - ap_dc, 8, 11990);
dt1 = clamp(loop_s * ratio * samplerate * mod1 - ap_dc, 8, 11990);
init = st.peek(44);
d0 = init < 0.5 ? dt0 : st.peek(0) + sm * (dt0 - st.peek(0));
d1 = init < 0.5 ? dt1 : st.peek(1) + sm * (dt1 - st.peek(1));
st.poke(d0, 0);
st.poke(d1, 1);
st.poke(1, 44);

// read (gen~ read(t) before write == reference read(t-1))
y0 = sp0.read(d0 + 1, interp="cubic");
y1 = sp1.read(d1 + 1, interp="cubic");
// output transducer: one-way = half round trip incl. half the dispersion
cw1 = cos(K * twopi * 1000 / samplerate);
ap_1k = 64 * K * (1 - a0 * a0) / (1 + 2 * a0 * cw1 + a0 * a0);
o0 = sp0.read(max(1, 0.5 * (d0 - ap_1k)) + 1, interp="cubic");
o1 = sp1.read(max(1, 0.5 * (d1 - ap_1k)) + 1, interp="cubic");
cth = cos(0.12);
sth = sin(0.12);
c0 = cth * y0 + sth * y1;
c1 = -sth * y0 + cth * y1;

a_mod = max(a0 * (1 + 0.04 * movement * w0b * 40), -0.9);
api = st.peek(27);
thr = max(1 - 0.7 * boing * slap, 0.25);

v0 = xin + g * c0 + splash;
v1 = xin + g * c1 + splash;
for (i = 0; i < 64; i += 1) {
	idx = i * 4 + api;
	wd0 = ap.peek(idx, 0);
	wa = v0 - a_mod * wd0;
	v0 = a_mod * wa + wd0;
	ap.poke(fixdenorm(wa), idx, 0);
	wd1 = ap.peek(idx, 1);
	wb = v1 - a_mod * wd1;
	v1 = a_mod * wb + wd1;
	ap.poke(fixdenorm(wb), idx, 1);
}
st.poke(api + 1 >= K ? 0 : api + 1, 27);

dm0 = st.peek(15) + c_damp * (v0 - st.peek(15));
dm1 = st.peek(16) + c_damp * (v1 - st.peek(16));
st.poke(fixdenorm(dm0), 15);
st.poke(fixdenorm(dm1), 16);

yb0 = b0 * dm0 + st.peek(17);
st.poke(fixdenorm(b1 * dm0 - a1 * yb0 + st.peek(18)), 17);
st.poke(fixdenorm(b2 * dm0 - a2 * yb0), 18);
yb1 = b0 * dm1 + st.peek(19);
st.poke(fixdenorm(b1 * dm1 - a1 * yb1 + st.peek(20)), 19);
st.poke(fixdenorm(b2 * dm1 - a2 * yb1), 20);

q0 = thr * tanh(yb0 * pnorm / thr);
q1 = thr * tanh(yb1 * pnorm / thr);
sp0.write(fixdenorm(q0));
sp1.write(fixdenorm(q1));

// output side: tank transducers (fitted to the K-10 IR: HP 200 Hz, 2nd-order LP 8 kHz),
// then the K-10 recovery amp, which its 680k||12pF feedback makes ~flat (LP 13 kHz)
c_r1 = opc(200);
c_r2 = opc(min(8000, 0.45 * samplerate));
c_r3 = opc(min(13000, 0.45 * samplerate));
ra = st.peek(51) + c_r1 * (o0 - st.peek(51)); st.poke(fixdenorm(ra), 51); o0 = o0 - ra;
rb = st.peek(52) + c_r2 * (o0 - st.peek(52)); st.poke(fixdenorm(rb), 52); o0 = rb;
rc = st.peek(53) + c_r2 * (o0 - st.peek(53)); st.poke(fixdenorm(rc), 53); o0 = rc;
rg = st.peek(58) + c_r3 * (o0 - st.peek(58)); st.poke(fixdenorm(rg), 58); o0 = rg;
rd = st.peek(54) + c_r1 * (o1 - st.peek(54)); st.poke(fixdenorm(rd), 54); o1 = o1 - rd;
re2 = st.peek(55) + c_r2 * (o1 - st.peek(55)); st.poke(fixdenorm(re2), 55); o1 = re2;
rf = st.peek(56) + c_r2 * (o1 - st.peek(56)); st.poke(fixdenorm(rf), 56); o1 = rf;
rh = st.peek(59) + c_r3 * (o1 - st.peek(59)); st.poke(fixdenorm(rh), 59); o1 = rh;
oo0 = o0 * out_scale;
oo1 = o1 * out_scale;
dcl = oo0 - st.peek(23) + r_dc * st.peek(24);
st.poke(oo0, 23);
st.poke(fixdenorm(dcl), 24);
dcr = oo1 - st.peek(25) + r_dc * st.peek(26);
st.poke(oo1, 25);
st.poke(fixdenorm(dcr), 26);
sL = dcl * mdg;
sR = dcr * mdg;

// ---------------- engine routing ----------------
cL = in4 * irg;
cR = in5 * irg;
wL = 0;
wR = 0;
if (have_ir < 0.5 && mode != 1) {
	wL = mode == 0 ? 0 : sL;
	wR = mode == 0 ? 0 : sR;
} else if (mode == 0) {
	wL = cL; wR = cR;
} else if (mode == 1) {
	wL = sL; wR = sR;
} else if (mode == 2) {
	gi = cos(0.5 * pi * bl);
	gm = sin(0.5 * pi * bl);
	wL = gi * cL + gm * sL; wR = gi * cR + gm * sR;
} else if (mode == 3) {
	wL = (1 - bl) * cL + bl * sL; wR = (1 - bl) * cR + bl * sR;
} else {
	wL = (1 - bl) * sL + bl * cL; wR = (1 - bl) * sR + bl * cR;
}
out4 = 0.5 * (sL + sR);

// feedback normalisation: 1 / estimated peak gain of the active engine path
pm = modelpeak(decay, tension, dispersion) * mdg;
pms = modelpeak(decay * 0.3, tension, dispersion) * mdg;
pir = ir_peak * irg;
pk = pm;
if (have_ir < 0.5) {
	pk = mode == 0 ? 1 : pm;
} else if (mode == 0) {
	pk = pir;
} else if (mode == 2) {
	pk = sqrt(pow(cos(0.5 * pi * bl) * pir, 2) + pow(sin(0.5 * pi * bl) * pm, 2));
} else if (mode == 3) {
	pk = sqrt(pow((1 - bl) * pir, 2) + pow(bl * pir * sqrt(pms), 2));
} else if (mode == 4) {
	pk = sqrt(pow((1 - bl) * pms, 2) + pow(bl * pir * pow(0.5 + pms, 0.75), 2));
}
fbnorm = 1 / max(pk, 0.05);

// ---------------- dub feedback loop ----------------
f = 0.5 * (wL + wR);
c_hp = opc(150 * pow(2, fb_tone * 1.6));
c_lp = opc(min(3000 * pow(2, fb_tone * 1.6), 0.45 * samplerate));
c_dm = opc(min(16000 * pow(1 - fb_damping, 2) + 800, 0.45 * samplerate));
h1 = st.peek(28) + c_hp * (f - st.peek(28)); st.poke(fixdenorm(h1), 28); f = f - h1;
h2 = st.peek(29) + c_hp * (f - st.peek(29)); st.poke(fixdenorm(h2), 29); f = f - h2;
l1 = st.peek(30) + c_lp * (f - st.peek(30)); st.poke(fixdenorm(l1), 30); f = l1;
l2 = st.peek(31) + c_lp * (f - st.peek(31)); st.poke(fixdenorm(l2), 31); f = l2;
l3 = st.peek(32) + c_dm * (f - st.peek(32)); st.poke(fixdenorm(l3), 32); f = l3;
f = asym(f, 1 + 14 * fb_drive, 0.1 * fb_drive);
grms = st.peek(34) + opc(1 / (twopi * 0.5)) * (f * f - st.peek(34));
st.poke(fixdenorm(grms), 34);
gs = 1 - self_osc;
guard = st.peek(35);
guard = st.peek(36) < 0.5 ? 1 : guard;      // first sample init
st.poke(1, 36);
gthr = self_osc > 0 ? max(0.01, 4 * pow(10, (-30 + 16 * self_osc) / 10)) : 0.01;
if (gs > 0 && grms > gthr) {
	guard = max(guard - gs / samplerate, 0.4);
} else {
	guard = min(guard + 0.5 / samplerate, 1);
}
st.poke(guard, 35);
// self-oscillation AGC (state 57): reaches the Self-Osc target level on any engine
og = st.peek(57);
og = og < 1 ? 1 : og;
osc_t = pow(10, (-30 + 16 * self_osc) / 10);
lvl = st.peek(33) * st.peek(33) * 0.5;      // fast peak envelope -> power
if (self_osc > 0) {
	if (lvl < 0.5 * osc_t) {
		og = min(og * pow(10, 2 / 20 / samplerate), 16);
	} else if (lvl > 2 * osc_t) {
		og = max(og * pow(10, -12 / 20 / samplerate), 1);
	}
} else {
	og = max(og * pow(10, -12 / 20 / samplerate), 1);
}
st.poke(og, 57);
f = f * (0.98 * feedback + 0.6 * self_osc) * fbnorm * guard * (1 + (og - 1) * self_osc);
fenv = max(abs(f), st.peek(33) * exp(-1 / (0.15 * samplerate)));
st.poke(fixdenorm(fenv), 33);
f = fenv > 0.5 ? f * 0.5 / fenv : f;
fdc = f - st.peek(37) + r_dc * st.peek(38);
st.poke(f, 37);
st.poke(fixdenorm(fdc), 38);
out3 = fdc;

// ---------------- output section ----------------
c_t = opc(900);
gl = pow(10, -6 * tone / 40);
gh = pow(10, 6 * tone / 40);
tl = st.peek(39) + c_t * (wL - st.peek(39)); st.poke(fixdenorm(tl), 39);
trr = st.peek(40) + c_t * (wR - st.peek(40)); st.poke(fixdenorm(trr), 40);
l = tl * gl + (wL - tl) * gh;
r = trr * gl + (wR - trr) * gh;
m = 0.5 * (l + r);
s = 0.5 * (l - r) * width;
l = asym(m + s, 1 + 2 * drive, 0.1);
r = asym(m - s, 1 + 2 * drive, 0.1);
odl = l - st.peek(41) + r_dc * st.peek(42); st.poke(l, 41); st.poke(fixdenorm(odl), 42);
odr = r - st.peek(43) + r_dc * st.peek(50); st.poke(r, 43); st.poke(fixdenorm(odr), 50);
gw = sin(0.5 * pi * mx);
gd = cos(0.5 * pi * mx);
out1 = (gd * in1 + gw * odl) * go;
out2 = (gd * in2 + gw * odr) * go;
