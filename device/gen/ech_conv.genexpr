// ECHOLIVITY gen~ CONVOLUTION  (zero latency, flat CPU)
// Mono in -> stereo out. Output = exact linear convolution with the conditioned IR,
// no added delay. Three stages, each hidden behind the IR segment it covers:
//
//   HEAD  h[0 .. 128)       direct-form FIR                     latency 0
//   MID   h[128 .. 4B)      overlap-save, 64-sample partitions  latency 128 = its offset
//   TAIL  h[4B .. end)      overlap-save, B-sample partitions   latency 4B  = its offset
//                           (B = 512 at <=48 kHz, 1024 at 88.2/96 kHz)
//
// TAIL pipeline, one stage per block so no sample does more than its share:
//   block j+1: forward FFT of input frame j      (spread over the block)
//   block j+2: multiply-accumulate all partitions (spread)
//   block j+3: inverse FFT, L and R in one complex transform (spread)
//   block j+4: played out                         -> latency 4B
// MID runs its two 128-point FFTs at its own 64-sample boundary (small).
//
// H buffer ---echH (2 channels, L/R), written by ech_ir_loader.js:
//   [0, 128)                    head FIR taps
//   [128, offT)                 mid spectra   (k*65 + bin)*2 + {0 re, 1 im}, k < KM
//   [offT, offT + K*(B+1)*2)    tail spectra  (k*(B+1) + bin)*2 + {0 re, 1 im}
//   KM = (4B - 128) / 64, offT = 128 + KM*130
// nparts < 0 mutes the convolver (IR being rewritten / none loaded).
// in1 mono input; out1 L, out2 R

Param nparts(-1, min=-1, max=400);
Param bsize(512, min=64, max=1024);
Buffer H("echH_unbound");

// head
Data xh(128);
History xw(0);
// mid
Data minb(128);
Data mfdl(8320);
Data macc(130, 2);
Data mre(128);
Data mim(128);
Data mtw(64, 2);
Data mrev(128);
Data moutb(64, 2);
History mcnt(0);
History mpos(0);
// tail
Data tring(3072);
Data tfdl(820000);
Data tacc(2050, 4);
Data toutb(1024, 4);
Data fre(2048);
Data fim(2048);
Data ire(2048);
Data iim(2048);
Data tw(1024, 2);
Data rev(2048);
History tcnt(0);
History tblk(0);
History tpos(0);
History fstart(0);
History bank(0);
History initB(0);
History initK(-2);

// gen~ scoping: declare every variable used inside loops/ifs at the top level
i = 0; j = 0; k = 0; b = 0; m = 0; u = 0; k0 = 0; k1 = 0; u0 = 0; u1 = 0; slot = 0;
fb = 0; hb = 0; xr = 0; xi = 0; hlr = 0; hli = 0; hrr = 0; hri = 0; v = 0;
tr = 0; ti = 0; s = 0; r = 0; half = 0; grp = 0; kk = 0; ia = 0; ib = 0; tix = 0;
wr = 0; wi = 0; pr = 0; pi2 = 0; vr = 0; vi = 0; ur = 0; ui = 0; base = 0;
alr = 0; ali = 0; arr = 0; ari = 0; q = 0; nb = 0; ab = 0; wb = 0; yl = 0; yr = 0;
hl = 0; hr = 0; ml = 0; mr = 0; tl = 0; trr = 0; lg = 0; KS = 0;

B = floor(bsize);
N = 2 * B;
K = floor(nparts);
on = K >= 0;
KT = max(K, 0);
KS = KT + 1;                       // tail FDL slots: one spare, written while the others are read
BM = 64;
NM = 128;
KM = floor((4 * B - 128) / 64);
offT = 128 + KM * (BM + 1) * 2;
lg = floor(log(N) / log(2) + 0.5);
UF = N + (N / 2) * lg + (B + 1);           // forward job: load, butterflies, store
UI = N + (B + 1) + (N / 2) * lg + B;       // inverse job: load, clear, butterflies, output

// ---------------- (re)initialise on block size / partition count change ----------------
if (initB != B || initK != K) {
	for (i = 0; i < NM / 2; i += 1) {
		poke(mtw, cos(twopi * i / NM), i, 0);
		poke(mtw, sin(twopi * i / NM), i, 1);
	}
	for (i = 0; i < NM; i += 1) {
		j = 0; m = i;
		for (k = 0; k < 7; k += 1) {
			j = j * 2 + (m % 2);
			m = floor(m / 2);
		}
		poke(mrev, j, i);
		poke(minb, 0, i);
	}
	for (i = 0; i < N / 2; i += 1) {
		poke(tw, cos(twopi * i / N), i, 0);
		poke(tw, sin(twopi * i / N), i, 1);
	}
	for (i = 0; i < N; i += 1) {
		j = 0; m = i;
		for (k = 0; k < lg; k += 1) {
			j = j * 2 + (m % 2);
			m = floor(m / 2);
		}
		poke(rev, j, i);
	}
	for (i = 0; i < 128; i += 1) {
		poke(xh, 0, i);
	}
	for (i = 0; i < KM * (BM + 1) * 2; i += 1) {
		poke(mfdl, 0, i);
	}
	for (i = 0; i < (BM + 1) * 2; i += 1) {
		poke(macc, 0, i, 0);
		poke(macc, 0, i, 1);
	}
	for (i = 0; i < BM; i += 1) {
		poke(moutb, 0, i, 0);
		poke(moutb, 0, i, 1);
	}
	for (i = 0; i < 3 * B; i += 1) {
		poke(tring, 0, i);
	}
	for (i = 0; i < KS * (B + 1) * 2; i += 1) {
		poke(tfdl, 0, i);
	}
	for (i = 0; i < (B + 1) * 2; i += 1) {
		poke(tacc, 0, i, 0); poke(tacc, 0, i, 1); poke(tacc, 0, i, 2); poke(tacc, 0, i, 3);
	}
	for (i = 0; i < B; i += 1) {
		poke(toutb, 0, i, 0); poke(toutb, 0, i, 1); poke(toutb, 0, i, 2); poke(toutb, 0, i, 3);
	}
	xw = 0; mcnt = 0; mpos = 0; tcnt = 0; tblk = 0; tpos = 0; fstart = 0; bank = 0;
	initB = B;
	initK = K;
}

x = on ? in1 : 0;

// ---------------- HEAD: direct FIR, taps 0..127 ----------------
poke(xh, x, xw);
hl = 0; hr = 0;
for (i = 0; i < 128; i += 1) {
	v = peek(xh, (xw - i + 128) % 128);
	hl += v * peek(H, i, 0);
	hr += v * peek(H, i, 1);
}
xw = (xw + 1) % 128;

// ---------------- MID: 64-sample uniform partitions ----------------
c = mcnt;
poke(minb, x, BM + c);
ml = peek(moutb, c, 0);
mr = peek(moutb, c, 1);
k0 = floor(c * KM / BM);
k1 = floor((c + 1) * KM / BM);
for (k = k0; k < k1; k += 1) {
	slot = (mpos + k) % KM;
	fb = slot * (BM + 1) * 2;
	hb = 128 + k * (BM + 1) * 2;
	for (b = 0; b <= BM; b += 1) {
		xr = peek(mfdl, fb + 2 * b);
		xi = peek(mfdl, fb + 2 * b + 1);
		hlr = peek(H, hb + 2 * b, 0);
		hli = peek(H, hb + 2 * b + 1, 0);
		hrr = peek(H, hb + 2 * b, 1);
		hri = peek(H, hb + 2 * b + 1, 1);
		poke(macc, peek(macc, 2 * b, 0) + xr * hlr - xi * hli, 2 * b, 0);
		poke(macc, peek(macc, 2 * b + 1, 0) + xr * hli + xi * hlr, 2 * b + 1, 0);
		poke(macc, peek(macc, 2 * b, 1) + xr * hrr - xi * hri, 2 * b, 1);
		poke(macc, peek(macc, 2 * b + 1, 1) + xr * hri + xi * hrr, 2 * b + 1, 1);
	}
}
if (c >= BM - 1) {
	// inverse: Z = L + iR (both spectra Hermitian), one complex IFFT -> re = l, im = r
	for (i = 0; i < NM; i += 1) {
		b = i <= BM ? i : NM - i;
		alr = peek(macc, 2 * b, 0); ali = peek(macc, 2 * b + 1, 0);
		arr = peek(macc, 2 * b, 1); ari = peek(macc, 2 * b + 1, 1);
		if (i <= BM) {
			tr = alr - ari; ti = ali + arr;
		} else {
			tr = alr + ari; ti = arr - ali;
		}
		j = peek(mrev, i);
		poke(mre, tr, j); poke(mim, ti, j);
	}
	for (i = 0; i < (BM + 1) * 2; i += 1) {
		poke(macc, 0, i, 0);
		poke(macc, 0, i, 1);
	}
	half = 1;
	while (half < NM) {
		for (i = 0; i < NM; i += 2 * half) {
			for (kk = 0; kk < half; kk += 1) {
				tix = kk * (NM / (2 * half));
				wr = peek(mtw, tix, 0);
				wi = peek(mtw, tix, 1);
				ia = i + kk; ib = ia + half;
				pr = peek(mre, ib); pi2 = peek(mim, ib);
				vr = pr * wr - pi2 * wi;
				vi = pr * wi + pi2 * wr;
				ur = peek(mre, ia); ui = peek(mim, ia);
				poke(mre, ur + vr, ia); poke(mim, ui + vi, ia);
				poke(mre, ur - vr, ib); poke(mim, ui - vi, ib);
			}
		}
		half *= 2;
	}
	for (b = 0; b < BM; b += 1) {
		poke(moutb, fixdenorm(peek(mre, BM + b) / NM), b, 0);
		poke(moutb, fixdenorm(peek(mim, BM + b) / NM), b, 1);
	}
	// forward: newest 128-sample frame
	for (i = 0; i < NM; i += 1) {
		j = peek(mrev, i);
		poke(mre, peek(minb, i), j); poke(mim, 0, j);
	}
	half = 1;
	while (half < NM) {
		for (i = 0; i < NM; i += 2 * half) {
			for (kk = 0; kk < half; kk += 1) {
				tix = kk * (NM / (2 * half));
				wr = peek(mtw, tix, 0);
				wi = -peek(mtw, tix, 1);
				ia = i + kk; ib = ia + half;
				pr = peek(mre, ib); pi2 = peek(mim, ib);
				vr = pr * wr - pi2 * wi;
				vi = pr * wi + pi2 * wr;
				ur = peek(mre, ia); ui = peek(mim, ia);
				poke(mre, ur + vr, ia); poke(mim, ui + vi, ia);
				poke(mre, ur - vr, ib); poke(mim, ui - vi, ib);
			}
		}
		half *= 2;
	}
	mpos = (mpos - 1 + KM) % KM;
	base = mpos * (BM + 1) * 2;
	for (b = 0; b <= BM; b += 1) {
		poke(mfdl, peek(mre, b), base + 2 * b);
		poke(mfdl, peek(mim, b), base + 2 * b + 1);
	}
	for (b = 0; b < BM; b += 1) {
		poke(minb, peek(minb, BM + b), b);
	}
	mcnt = 0;
} else {
	mcnt = c + 1;
}

// ---------------- TAIL: B-sample partitions, pipelined ----------------
c = tcnt;
poke(tring, x, tblk * B + c);
ab = bank;                         // accumulator being filled this block (MAC)
wb = 1 - bank;                     // accumulator being transformed (inverse) / output written
tl = peek(toutb, c, 2 * bank);
trr = peek(toutb, c, 2 * bank + 1);

if (KT > 0) {
	// (a) forward FFT of the frame captured at the last boundary, units u0..u1-1
	u0 = floor(c * UF / B);
	u1 = floor((c + 1) * UF / B);
	for (u = u0; u < u1; u += 1) {
		if (u < N) {
			poke(fre, peek(tring, (fstart + u) % (3 * B)), peek(rev, u));
			poke(fim, 0, peek(rev, u));
		} else if (u < N + (N / 2) * lg) {
			q = u - N;
			s = floor(q / (N / 2));
			r = q - s * (N / 2);
			half = pow(2, s);
			grp = floor(r / half);
			kk = r - grp * half;
			ia = grp * 2 * half + kk; ib = ia + half;
			tix = kk * (N / (2 * half));
			wr = peek(tw, tix, 0);
			wi = -peek(tw, tix, 1);
			pr = peek(fre, ib); pi2 = peek(fim, ib);
			vr = pr * wr - pi2 * wi;
			vi = pr * wi + pi2 * wr;
			ur = peek(fre, ia); ui = peek(fim, ia);
			poke(fre, ur + vr, ia); poke(fim, ui + vi, ia);
			poke(fre, ur - vr, ib); poke(fim, ui - vi, ib);
		} else {
			b = u - N - (N / 2) * lg;
			base = ((tpos - 1 + KS) % KS) * (B + 1) * 2;      // the spare slot
			poke(tfdl, peek(fre, b), base + 2 * b);
			poke(tfdl, peek(fim, b), base + 2 * b + 1);
		}
	}
	// (b) multiply-accumulate partitions k0..k1-1 into accumulator ab
	k0 = floor(c * KT / B);
	k1 = floor((c + 1) * KT / B);
	for (k = k0; k < k1; k += 1) {
		slot = (tpos + k) % KS;
		fb = slot * (B + 1) * 2;
		hb = offT + k * (B + 1) * 2;
		for (b = 0; b <= B; b += 1) {
			xr = peek(tfdl, fb + 2 * b);
			xi = peek(tfdl, fb + 2 * b + 1);
			hlr = peek(H, hb + 2 * b, 0);
			hli = peek(H, hb + 2 * b + 1, 0);
			hrr = peek(H, hb + 2 * b, 1);
			hri = peek(H, hb + 2 * b + 1, 1);
			poke(tacc, peek(tacc, 2 * b, 2 * ab) + xr * hlr - xi * hli, 2 * b, 2 * ab);
			poke(tacc, peek(tacc, 2 * b + 1, 2 * ab) + xr * hli + xi * hlr, 2 * b + 1, 2 * ab);
			poke(tacc, peek(tacc, 2 * b, 2 * ab + 1) + xr * hrr - xi * hri, 2 * b, 2 * ab + 1);
			poke(tacc, peek(tacc, 2 * b + 1, 2 * ab + 1) + xr * hri + xi * hrr, 2 * b + 1, 2 * ab + 1);
		}
	}
	// (c) inverse FFT of accumulator wb (filled last block) into output bank wb
	u0 = floor(c * UI / B);
	u1 = floor((c + 1) * UI / B);
	for (u = u0; u < u1; u += 1) {
		if (u < N) {
			b = u <= B ? u : N - u;
			alr = peek(tacc, 2 * b, 2 * wb); ali = peek(tacc, 2 * b + 1, 2 * wb);
			arr = peek(tacc, 2 * b, 2 * wb + 1); ari = peek(tacc, 2 * b + 1, 2 * wb + 1);
			if (u <= B) {
				tr = alr - ari; ti = ali + arr;
			} else {
				tr = alr + ari; ti = arr - ali;
			}
			poke(ire, tr, peek(rev, u)); poke(iim, ti, peek(rev, u));
		} else if (u < N + B + 1) {
			b = u - N;
			poke(tacc, 0, 2 * b, 2 * wb); poke(tacc, 0, 2 * b + 1, 2 * wb);
			poke(tacc, 0, 2 * b, 2 * wb + 1); poke(tacc, 0, 2 * b + 1, 2 * wb + 1);
		} else if (u < N + B + 1 + (N / 2) * lg) {
			q = u - N - B - 1;
			s = floor(q / (N / 2));
			r = q - s * (N / 2);
			half = pow(2, s);
			grp = floor(r / half);
			kk = r - grp * half;
			ia = grp * 2 * half + kk; ib = ia + half;
			tix = kk * (N / (2 * half));
			wr = peek(tw, tix, 0);
			wi = peek(tw, tix, 1);
			pr = peek(ire, ib); pi2 = peek(iim, ib);
			vr = pr * wr - pi2 * wi;
			vi = pr * wi + pi2 * wr;
			ur = peek(ire, ia); ui = peek(iim, ia);
			poke(ire, ur + vr, ia); poke(iim, ui + vi, ia);
			poke(ire, ur - vr, ib); poke(iim, ui - vi, ib);
		} else {
			b = u - N - B - 1 - (N / 2) * lg;
			poke(toutb, fixdenorm(peek(ire, B + b) / N), b, 2 * wb);
			poke(toutb, fixdenorm(peek(iim, B + b) / N), b, 2 * wb + 1);
		}
	}
}

if (c >= B - 1) {
	// frame = the two most recent blocks; it stays intact in the 3-block ring
	// while the next block is written, which is when (a) reads it
	fstart = ((tblk + 2) % 3) * B;
	tblk = (tblk + 1) % 3;
	tpos = (tpos - 1 + KS) % KS;
	bank = 1 - bank;
	tcnt = 0;
} else {
	tcnt = c + 1;
}

out1 = on ? hl + ml + tl : 0;
out2 = on ? hr + mr + trr : 0;
